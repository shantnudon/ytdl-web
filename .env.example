# Copy to .env and adjust. All settings are optional.

# ---- Security -------------------------------------------------------------
# If set, the UI asks for this password and every /api route requires it.
# Leave empty for a trusted localhost-only setup.
APP_PASSWORD=

# 127.0.0.1 keeps the UI private. Use 0.0.0.0 inside Docker (the container
# itself is the boundary) or behind a TLS reverse proxy.
APP_HOST=127.0.0.1
APP_PORT=8080

# ---- Directories ----------------------------------------------------------
# Base directory for all runtime state (db, cookies, extractor plugins).
# DOWNLOAD_DIR / LIBRARY_DIR / CONFIG_DIR default to subdirectories of this.
YTDLWEB_DATA_DIR=./data
DOWNLOAD_DIR=
LIBRARY_DIR=
CONFIG_DIR=

# ---- Behaviour ------------------------------------------------------------
# Library writes (tag edits, renames) are disabled unless this is true.
ALLOW_WRITE=false
MAX_CONCURRENT=3
LOG_LEVEL=info

# ---- Media ----------------------------------------------------------------
# Optional explicit ffmpeg. If empty: imageio-ffmpeg (binary builds) then PATH.
FFMPEG_PATH=
# Optional cookies.txt for age-restricted / member-only content.
COOKIES_FILE=
